# MongoDB Configuration
# Local Docker (default; run on the host). The quickstart's MongoDB 8.2 container
# serves both Temporal and the app.
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
# Atlas instead (needs VPC peering when deployed; see README "Using Atlas"):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/
# To run the app AND Temporal against Atlas inside docker compose, also set:
# MONGODB_URI_DOCKER=mongodb+srv://<username>:<password>@cluster.mongodb.net/
# TEMPORAL_MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/
MONGODB_DB_NAME=transaction_ai_poc

# Temporal Configuration
# Docker compose overrides this to temporal:7233
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=transaction-processing-queue

# AWS Configuration (Required for AWS Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# API Configuration
# For local development use: http://localhost:8000/api
# For Docker use: http://api:8000/api
API_BASE_URL=http://localhost:8000/api

# LLM Provider Configuration
# Choose between 'bedrock' (default, Claude via AWS Bedrock) or 'groq'
LLM_PROVIDER=bedrock

# Groq Configuration (Required if LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# Embedding Configuration
VOYAGE_API_KEY=your_voyage_api_key_here
# Cohere via Bedrock is used as fallback when Voyage is unavailable

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD_APPROVE=85
CONFIDENCE_THRESHOLD_ESCALATE=70
AUTO_APPROVAL_LIMIT=50000